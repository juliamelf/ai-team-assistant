# Скопируйте этот файл в .env и заполните значения. Файл .env в репозиторий не попадает.

# Telegram
TELEGRAM_BOT_TOKEN=

# GigaChat
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
